# Loaded automatically by Vite/Vitest in test mode. .env.local is
# intentionally NOT loaded during tests (so results don't depend on a
# developer's local machine config), so the test API base URL lives here
# instead. MSW intercepts every request in tests - this value is never
# actually dialed, it just has to satisfy env.ts's fail-fast check.
VITE_API_BASE_URL=http://localhost:8800
